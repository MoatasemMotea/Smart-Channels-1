# Smart Channels website — environment template.
# No variables are required for local development or build.

# Set to "true" ONLY on the authorized production deployment.
# Anything else (including unset) keeps the site noindex + robots-disallowed.
# NEXT_PUBLIC_ALLOW_INDEXING=true

# Reserved for a future, separately-approved analytics provider (see src/lib/analytics.ts).
# NEXT_PUBLIC_ANALYTICS_PROVIDER=
