{
  "name": "smart-channels-website",
  "version": "0.3.0",
  "private": true,
  "description": "Smart Channels corporate website \u2014 bilingual (EN/AR), dark/light, cinematic technology experience.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-content.ts",
    "validate:release": "tsx scripts/validate-content.ts --release",
    "media": "tsx scripts/media-ingest.ts && tsx scripts/generate-posters.ts",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run validate && npm run test",
    "generate:opening": "tsx scripts/generate-opening-data.ts"
  },
  "dependencies": {
    "next": "16.3.3",
    "next-intl": "4.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}